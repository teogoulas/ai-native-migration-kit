#!/usr/bin/env bash
# ai-native-verify — deterministic audit of an AI-native repository.
#
# Runs the 18 deterministic criteria (D01–D18) from
# plugins/ai-native-migration/references/ai-native-checklist.md against a target directory. No LLM,
# no network. Pure bash + POSIX tools. Runnable in CI, pre-push hooks, or by
# hand.
#
# See `ai-native-verify --help` for the contract.
#
# T-08 scaffolding: this file establishes the CLI, preflight, output formats,
# exit codes, and a stub check-runner that returns n/a for every check.
# T-09 fills in D01–D09; T-10 fills in D10–D18; T-11 finalizes JSON output.

set -euo pipefail

# ---------- locate helpers ----------

# Resolve script directory (symlink-aware) so we can source lib/common.sh
# whether invoked via absolute path, relative path, or via a symlink from
# ~/.claude/skills/ai-native-migration/scripts/.
_resolve_dir() {
  local src=$1
  while [[ -L $src ]]; do
    local dir
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ $src != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR=$(_resolve_dir "${BASH_SOURCE[0]}")
readonly SCRIPT_DIR

# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

# ---------- usage ----------

usage() {
  cat <<'EOF'
ai-native-verify — deterministic audit of an AI-native repository

Usage:
  ai-native-verify [--format=text|json] [--check=<ids>] <target-repo>
  ai-native-verify --help
  ai-native-verify --version

Options:
  --format=<text|json>   Output format. Default: text.
  --check=<ids>          Comma-separated list of check IDs to run
                         (e.g. --check=D01,D02,D06). Omitted = all 18.
  --no-color             Disable ANSI color in text output.
  --help                 Print this message and exit 0.
  --version              Print rubric version and exit 0.

Exit codes:
  0  All checks pass or n/a
  1  At least one criterion is `partial` (structural presence, quality gap)
  2  At least one criterion is `fail`
  3  Preflight failure (not a git repo, path missing, unreadable, malformed
     arguments)

Rubric source of truth:
  plugins/ai-native-migration/references/ai-native-checklist.md — Part 1, criteria D01–D18.
  If a check's implementation drifts from the rubric, the rubric wins.

Examples:
  ai-native-verify .
  ai-native-verify --format=json /path/to/repo | jq '.summary'
  ai-native-verify --check=D01,D02 .
EOF
}

# ---------- argument parsing ----------

FORMAT=text
CHECKS=""      # empty = all
NO_COLOR=0
TARGET=""

while (( $# > 0 )); do
  case $1 in
    --help|-h)     usage; exit 0 ;;
    --version)     printf 'ai-native-verify %s (rubric %s)\n' "$ANMK_RUBRIC_VERSION" "$ANMK_RUBRIC_VERSION"; exit 0 ;;
    --format=*)    FORMAT=${1#--format=} ;;
    --format)      shift; FORMAT=${1:-} ;;
    --check=*)     CHECKS=${1#--check=} ;;
    --check)       shift; CHECKS=${1:-} ;;
    --no-color)    NO_COLOR=1 ;;
    --)            shift; break ;;
    -*)            die "unknown option: $1 (see --help)" ;;
    *)             if [[ -z $TARGET ]]; then TARGET=$1; else die "unexpected argument: $1"; fi ;;
  esac
  shift
done

# Preflight — bail with exit 3 for anything malformed. Preflight failures are
# NOT audit findings; they are usage errors.
case $FORMAT in
  text|json) ;;
  *) die --code=3 "invalid --format: $FORMAT (want text or json)" ;;
esac

[[ -n $TARGET ]] || die --code=3 "missing target repo path (see --help)"

# require_readable_dir dies with exit 1 by default; upgrade to 3 for preflight.
if [[ ! -e $TARGET ]]; then die --code=3 "path does not exist: $TARGET"; fi
if [[ ! -d $TARGET ]]; then die --code=3 "path is not a directory: $TARGET"; fi
if [[ ! -r $TARGET ]]; then die --code=3 "path is not readable: $TARGET"; fi

TARGET=$(absolute_path "$TARGET")
readonly TARGET FORMAT NO_COLOR

# ---------- check registry ----------

# The full list of check IDs. Order matters for output — checks are emitted
# in this order. See ai-native-checklist.md §Part 1.
readonly ALL_CHECKS=(
  D01 D02 D03 D04 D05 D06 D07 D08 D09
  D10 D11 D12 D13 D14 D15 D16 D17 D18
)

# One-line human-readable label per check. Kept in sync with the rubric.
declare -A CHECK_LABEL=(
  [D01]="AGENTS.md present with canonical sections"
  [D02]="CLAUDE.md is a symlink to AGENTS.md"
  [D03]=".claude/settings.json with denyList and hooks"
  [D04]=".mcp.json present when the team uses MCP"
  [D05]="Reproducible environment mechanism present"
  [D06]=".pre-commit-config.yaml present"
  [D07]=".editorconfig at repo root"
  [D08]="docs quartet (ARCHITECTURE, DEVELOPMENT, TESTING, PRECOMMIT)"
  [D09]="docs/specs/ directory exists"
  [D10]="Unit test folder(s) exist"
  [D11]="Integration test folder(s) exist"
  [D12]="E2E test harness (folder or config)"
  [D13]="CI config with build+test+lint gates"
  [D14]="AI review layer configured"
  [D15]="Conventional Commits enabled"
  [D16]="Stack-specific linter/style config present"
  [D17]=".claude/commands/ or .claude/skills/ non-empty"
  [D18]="Onboarding automation activates guardrails"
)

# Severity per check (added rubric v0.2.0). Maps to the plan-file synthesizer's
# tier grouping and the differentiated exit-code logic below:
#   mandatory    → fail triggers exit code 2 (blocking)
#   nice-to-have → fail triggers exit code 1 (advisory) if no mandatory fails
#   conditional  → returns n/a when the target context doesn't apply
#
# Kept in sync with the rubric's §Severity field per criterion. Drift = bug.
readonly SEVERITY_MANDATORY=mandatory
readonly SEVERITY_NICE_TO_HAVE=nice-to-have
readonly SEVERITY_CONDITIONAL=conditional
declare -A CHECK_SEVERITY=(
  [D01]="$SEVERITY_MANDATORY"
  [D02]="$SEVERITY_MANDATORY"
  [D03]="$SEVERITY_MANDATORY"
  [D04]="$SEVERITY_CONDITIONAL"
  [D05]="$SEVERITY_MANDATORY"
  [D06]="$SEVERITY_MANDATORY"
  [D07]="$SEVERITY_MANDATORY"
  [D08]="$SEVERITY_MANDATORY"
  [D09]="$SEVERITY_MANDATORY"
  [D10]="$SEVERITY_MANDATORY"
  [D11]="$SEVERITY_MANDATORY"
  [D12]="$SEVERITY_MANDATORY"
  [D13]="$SEVERITY_MANDATORY"
  [D14]="$SEVERITY_NICE_TO_HAVE"
  [D15]="$SEVERITY_MANDATORY"
  [D16]="$SEVERITY_MANDATORY"
  [D17]="$SEVERITY_NICE_TO_HAVE"
  [D18]="$SEVERITY_MANDATORY"
)

# Per-check scope. See ai-native-checklist.md §5 (added v0.2.0). Any check
# not listed here defaults to SCOPE_ROOT_ONLY. Applied by run_check() below.
declare -A CHECK_SCOPE=(
  [D08]="$SCOPE_ROOT_PRIMARY"
  [D10]="$SCOPE_PER_WORKSPACE"
  [D11]="$SCOPE_PER_WORKSPACE"
  [D12]="$SCOPE_PER_WORKSPACE"
  [D16]="$SCOPE_ROOT_PRIMARY"
)

# ---------- resolve which checks to run ----------

# Validate check IDs UP FRONT in the parent process. We can't validate inside
# resolve_checks because it's invoked via `< <(resolve_checks ...)`, a process
# substitution that runs the function in a subshell — a `die --code=3` there
# would exit the subshell only, leaving the parent to continue with zero
# results and exit 0 (masking the usage error). Validating here fixes that.
if [[ -n $CHECKS ]]; then
  IFS=',' read -ra _requested_parts <<<"$CHECKS"
  for _id in "${_requested_parts[@]}"; do
    _id=${_id// /}
    [[ -z $_id ]] && continue
    if [[ -z ${CHECK_LABEL[$_id]:-} ]]; then
      die --code=3 "unknown check id: $_id (valid: ${ALL_CHECKS[*]})"
    fi
  done
  unset _id _requested_parts
fi

resolve_checks() {
  local requested=$1
  if [[ -z $requested ]]; then
    printf '%s\n' "${ALL_CHECKS[@]}"
    return
  fi
  # IDs have already been validated by the parent (see above). Dedupe and
  # preserve rubric order.
  local -A wanted=()
  local id
  IFS=',' read -ra parts <<<"$requested"
  for id in "${parts[@]}"; do
    id=${id// /}
    [[ -z $id ]] && continue
    wanted[$id]=1
  done
  for id in "${ALL_CHECKS[@]}"; do
    [[ ${wanted[$id]:-0} == 1 ]] && printf '%s\n' "$id"
  done
}

CHECKS_TO_RUN=()
while IFS= read -r id; do CHECKS_TO_RUN+=("$id"); done < <(resolve_checks "$CHECKS")

# ---------- check dispatcher ----------

# Each check function has this contract:
#   input:  reads $TARGET (readonly)
#   output: prints "<verdict>|<evidence>|<remediation>" to stdout
#           verdict ∈ {pass, partial, fail, n/a}
#           evidence and remediation are one-line strings; empty allowed;
#           `|` characters in payloads MUST be escaped as `\p` before emission
#           (helper below).
# Rationale for the pipe-delimited protocol: cheaper than a JSON layer per
# check, and every check's output is at most three fields.
#
# T-08 stubs all 18 checks as n/a with a "not-yet-implemented" note.
# T-09 replaces D01–D09; T-10 replaces D10–D18. Do not add real check logic
# to this file until those tasks — this scaffolding must remain trivially
# reviewable.

_pipe_escape() {
  # Escape | -> \p in a field so the delimiter stays unambiguous.
  local s=$1
  printf '%s' "${s//|/\\p}"
}

emit_result() {
  # emit_result <verdict> <evidence> <remediation>
  printf '%s|%s|%s\n' "$1" "$(_pipe_escape "$2")" "$(_pipe_escape "$3")"
}

# stub — every check returns n/a with the same message. Replaced in T-09/T-10.
_check_stub() {
  emit_result "$VERDICT_NA" "check not yet implemented (T-08 scaffolding)" ""
}

# ---------- D01 — AGENTS.md present with canonical sections ----------
# Rubric §Part 1 D01, v0.2.0. Pass: file exists, non-empty, all five canonical
# section headings present by name. Fail: missing / empty / any section missing.
# Partial is no longer used for D01 (v0.2.0 — the section check is all-or-
# nothing to keep the prerequisite tight). See Q-10 in the questions file.
check_D01() {
  local f="$TARGET/AGENTS.md"
  if [[ ! -f $f ]]; then
    emit_result "$VERDICT_FAIL" "AGENTS.md missing at repo root" \
      "create AGENTS.md at repo root (see plugins/ai-native-migration/templates/AGENTS.md.tmpl)"
    return
  fi
  if [[ ! -s $f ]]; then
    emit_result "$VERDICT_FAIL" "AGENTS.md exists but is empty" \
      "populate AGENTS.md with the five canonical sections (Project Overview, Coding Standards, Key Commands, Architecture Notes, Things to Avoid)"
    return
  fi
  # Check for each of the five canonical section headings at any Markdown
  # heading level (#, ##, ### ...). Case-sensitive match on the exact
  # section name per Q-10 decision.
  local -a canonical=(
    "Project Overview"
    "Coding Standards"
    "Key Commands"
    "Architecture Notes"
    "Things to Avoid"
  )
  local -a missing=()
  local sec
  for sec in "${canonical[@]}"; do
    if ! grep -qE "^#+[[:space:]]+${sec}([[:space:]]|\$)" "$f" 2>/dev/null; then
      missing+=("$sec")
    fi
  done
  if (( ${#missing[@]} == 0 )); then
    emit_result "$VERDICT_PASS" "AGENTS.md present with all five canonical sections" ""
    return
  fi
  # Fail; enumerate what's missing so the plan file's remediation is precise.
  local missing_joined
  missing_joined=$(IFS='; '; echo "${missing[*]}")
  emit_result "$VERDICT_FAIL" "AGENTS.md missing canonical section(s): ${missing_joined}" \
    "add the missing section headings; use plugins/ai-native-migration/templates/AGENTS.md.tmpl as a starting point"
}

# ---------- D02 — CLAUDE.md is a symlink to AGENTS.md ----------
# Pass: symlink resolves to AGENTS.md. Partial: exists as regular file
# (duplicate content that will drift). Fail: missing.
check_D02() {
  local f="$TARGET/CLAUDE.md"
  if [[ ! -e $f && ! -L $f ]]; then
    emit_result "$VERDICT_FAIL" "CLAUDE.md missing" \
      "from repo root: rm -f CLAUDE.md && ln -s AGENTS.md CLAUDE.md"
    return
  fi
  if [[ -L $f ]]; then
    local target
    target=$(readlink "$f")
    if [[ $target == "AGENTS.md" ]]; then
      emit_result "$VERDICT_PASS" "CLAUDE.md → AGENTS.md" ""
      return
    fi
    emit_result "$VERDICT_PARTIAL" "CLAUDE.md is a symlink but points to '$target' instead of AGENTS.md" \
      "fix symlink: rm CLAUDE.md && ln -s AGENTS.md CLAUDE.md"
    return
  fi
  emit_result "$VERDICT_PARTIAL" "CLAUDE.md is a regular file (should be a symlink to AGENTS.md)" \
    "replace with symlink: rm CLAUDE.md && ln -s AGENTS.md CLAUDE.md — keeps a single source of truth"
}

# ---------- D03 — .claude/settings.json with denyList and hooks ----------
# JSON must be valid AND contain a non-empty denyList AND a non-empty hooks object.
# Pass: both. Partial: valid JSON, only one populated. Fail: missing or invalid.
#
# We use python3 for JSON validation because it is universal on CI runners and
# does not require jq. Fall back to a naive grep if python3 is absent.
_json_has_field() {
  # _json_has_field <file> <top-level-key> <expected-nonempty: array|object>
  # Returns 0 if the file is valid JSON and contains the given non-empty top-level field.
  local file=$1 key=$2 kind=$3
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$key" "$kind" <<'PY' 2>/dev/null
import json, sys
path, key, kind = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    sys.exit(2)
val = data.get(key)
if val is None:
    sys.exit(1)
if kind == "array" and isinstance(val, list) and len(val) > 0:
    sys.exit(0)
if kind == "object" and isinstance(val, dict) and len(val) > 0:
    sys.exit(0)
sys.exit(1)
PY
    return $?
  fi
  # Fallback: naive grep. Accept the check as "populated" if the key appears
  # followed by [ or {. This can false-positive on commented-out entries but
  # matches the check's spirit for environments without python3.
  grep -qE "\"$key\"[[:space:]]*:[[:space:]]*[\[{]" "$file"
}

check_D03() {
  local f="$TARGET/.claude/settings.json"
  if [[ ! -f $f ]]; then
    emit_result "$VERDICT_FAIL" ".claude/settings.json missing" \
      "copy plugins/ai-native-migration/templates/.claude/settings.json.tmpl into .claude/settings.json"
    return
  fi
  # Validity check first — invalid JSON = fail regardless of content.
  if command -v python3 >/dev/null 2>&1; then
    if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null; then
      emit_result "$VERDICT_FAIL" ".claude/settings.json exists but is not valid JSON" \
        "fix JSON syntax; validate with 'python3 -m json.tool .claude/settings.json'"
      return
    fi
  fi
  local has_deny=0 has_hooks=0
  _json_has_field "$f" "denyList" "array" && has_deny=1
  _json_has_field "$f" "hooks" "object" && has_hooks=1
  if (( has_deny && has_hooks )); then
    emit_result "$VERDICT_PASS" "settings.json has denyList and hooks populated" ""
    return
  fi
  if (( has_deny || has_hooks )); then
    local present=""
    (( has_deny )) && present="denyList"
    (( has_hooks )) && present="hooks"
    emit_result "$VERDICT_PARTIAL" "settings.json present but only '$present' is populated" \
      "add the missing element; see plugins/ai-native-migration/templates/.claude/settings.json.tmpl for a baseline"
    return
  fi
  emit_result "$VERDICT_FAIL" "settings.json present but neither denyList nor hooks populated" \
    "populate both; see plugins/ai-native-migration/templates/.claude/settings.json.tmpl"
}

# ---------- D04 — .mcp.json present when the team uses MCP ----------
# Rubric §Part 1 D04, v0.2.0 — conditional severity. Pass: .mcp.json is valid
# JSON. Fail: AGENTS.md declares MCP usage but .mcp.json is missing. N/A: no
# declaration and no file (the team hasn't opted in). See Q-10 for the shift
# from mandatory to conditional.
check_D04() {
  local f="$TARGET/.mcp.json"
  local agents="$TARGET/AGENTS.md"
  # Case A — file exists: verify JSON validity.
  if [[ -f $f ]]; then
    if command -v python3 >/dev/null 2>&1; then
      if python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null; then
        emit_result "$VERDICT_PASS" ".mcp.json present and valid JSON" ""
        return
      fi
      emit_result "$VERDICT_PARTIAL" ".mcp.json exists but is invalid JSON" \
        "fix JSON syntax; validate with 'python3 -m json.tool .mcp.json'"
      return
    fi
    emit_result "$VERDICT_PASS" ".mcp.json present" ""
    return
  fi
  # Case B — no file. Check whether AGENTS.md declares MCP usage.
  # A declaration is: any Markdown heading containing 'MCP' (e.g. '## MCP
  # servers'), OR any line that names 'MCP servers' / 'MCP tools' in a
  # positive statement, OR a bullet under 'Key Commands' referencing an
  # MCP server. Case-insensitive.
  local declares_mcp=0
  if [[ -f $agents ]]; then
    if grep -qiE '(^#+[[:space:]].*\bMCP\b|MCP[[:space:]]+servers?|MCP[[:space:]]+tools?)' "$agents"; then
      declares_mcp=1
    fi
  fi
  if (( declares_mcp )); then
    emit_result "$VERDICT_FAIL" "AGENTS.md declares MCP usage but .mcp.json is missing" \
      "add .mcp.json with the declared server configuration; see plugins/ai-native-migration/templates/.mcp.json.tmpl"
    return
  fi
  # No file, no declaration → not applicable to this repo.
  emit_result "$VERDICT_NA" "no MCP declaration in AGENTS.md; team has not opted into MCP" ""
}

# ---------- D05 — Reproducible environment mechanism present ----------
# Rubric §Part 1 D05, v0.2.0 — broadened. Pass: any of the following present:
# valid .devcontainer/, Tiltfile, docker-compose.yml/yaml, .sdkmanrc, .nvmrc,
# .python-version, .tool-versions. Partial: only an incomplete .devcontainer/
# and no other mechanism as fallback. Fail: none of the mechanisms detected.
# See Q-10 for the shift from devcontainer-only to any-mechanism.
check_D05() {
  local -a evidence=()

  # 1. .devcontainer/ path (existing check — full satisfaction).
  local d="$TARGET/.devcontainer"
  local devcontainer_complete=0 devcontainer_stub=0
  if [[ -d $d ]]; then
    local has_dcj=0 has_image=0 has_dockerfile=0
    [[ -f "$d/devcontainer.json" ]] && has_dcj=1
    [[ -f "$d/Dockerfile" ]] && has_dockerfile=1
    if (( has_dcj )) && grep -qE '"image"[[:space:]]*:' "$d/devcontainer.json" 2>/dev/null; then
      has_image=1
    fi
    if (( has_dcj && ( has_dockerfile || has_image ) )); then
      devcontainer_complete=1
      local imgnote="devcontainer.json"
      (( has_dockerfile )) && imgnote="$imgnote + Dockerfile"
      (( has_image && ! has_dockerfile )) && imgnote="$imgnote + image reference"
      evidence+=("$imgnote")
    elif (( has_dcj )); then
      devcontainer_stub=1
    fi
  fi

  # 2. Alternative reproducible-env mechanisms.
  local f
  for f in Tiltfile docker-compose.yml docker-compose.yaml .sdkmanrc .nvmrc .python-version .tool-versions; do
    if [[ -f "$TARGET/$f" ]]; then
      evidence+=("$f")
    fi
  done

  if (( ${#evidence[@]} > 0 )); then
    local evjoin
    evjoin=$(IFS=, ; echo "${evidence[*]}")
    emit_result "$VERDICT_PASS" "reproducible-env mechanism(s): ${evjoin}" ""
    return
  fi

  # Nothing else and .devcontainer/ was only a stub → partial.
  if (( devcontainer_stub )); then
    emit_result "$VERDICT_PARTIAL" ".devcontainer/ exists but is incomplete (no Dockerfile and no image reference); no fallback mechanism" \
      "complete the devcontainer setup OR add one of: Tiltfile, docker-compose.yml, .sdkmanrc, .nvmrc, .python-version, .tool-versions"
    return
  fi

  emit_result "$VERDICT_FAIL" "no reproducible-environment mechanism detected" \
    "add at least one of: .devcontainer/, Tiltfile, docker-compose.yml, .sdkmanrc, .nvmrc, .python-version, .tool-versions"
}

# ---------- D06 — .pre-commit-config.yaml present ----------
# Pass: file exists AND contains a non-empty repos: list.
# Partial: file exists but repos: empty.
# Fail: file missing.
check_D06() {
  local f="$TARGET/.pre-commit-config.yaml"
  # Some teams use .pre-commit-hooks.yaml or the -yml extension; accept.
  if [[ ! -f $f ]]; then
    local alt
    for alt in "$TARGET/.pre-commit-config.yml" "$TARGET/.pre-commit-hooks.yaml"; do
      if [[ -f $alt ]]; then f=$alt; break; fi
    done
  fi
  if [[ ! -f $f ]]; then
    emit_result "$VERDICT_FAIL" ".pre-commit-config.yaml missing" \
      "copy plugins/ai-native-migration/templates/.pre-commit-config.yaml.tmpl; pair with D18 (onboarding activation)"
    return
  fi
  # Detect "repos:" line and check whether the next non-blank, non-comment
  # line looks like a list item. Cheap YAML heuristic; avoids adding a
  # YAML-parser dependency.
  if ! grep -qE '^repos[[:space:]]*:' "$f"; then
    emit_result "$VERDICT_PARTIAL" "pre-commit config present but has no 'repos:' key" \
      "add a repos: list; see plugins/ai-native-migration/templates/.pre-commit-config.yaml.tmpl"
    return
  fi
  # Look for at least one hook entry (`- repo:`) below repos:.
  if awk '
    /^repos[[:space:]]*:/ { inrepos=1; next }
    inrepos && /^[[:space:]]*-[[:space:]]+repo[[:space:]]*:/ { found=1; exit }
    /^[^[:space:]]/ && !/^repos[[:space:]]*:/ { inrepos=0 }
    END { exit found ? 0 : 1 }
  ' "$f"; then
    emit_result "$VERDICT_PASS" "$(basename "$f") present with at least one repo hook" ""
    return
  fi
  emit_result "$VERDICT_PARTIAL" "$(basename "$f") present but repos: list is empty" \
    "populate with baseline hooks (trailing-whitespace, end-of-file-fixer, commit-msg linter)"
}

# ---------- D07 — .editorconfig at repo root ----------
# Pass: file at repo root. Partial: file only in a subdirectory. Fail: missing.
check_D07() {
  local root="$TARGET/.editorconfig"
  if [[ -f $root ]]; then
    emit_result "$VERDICT_PASS" ".editorconfig at repo root" ""
    return
  fi
  # Check for .editorconfig in any subdir — flag as partial (missing root sentinel).
  local sub
  sub=$(find "$TARGET" -maxdepth 3 -type f -name .editorconfig \
    \( -path '*/node_modules' -o -path '*/.git' -o -path '*/target' -o -path '*/dist' -o -path '*/build' \) -prune \
    -o -type f -name .editorconfig -print 2>/dev/null | head -n1)
  if [[ -n $sub ]]; then
    emit_result "$VERDICT_PARTIAL" ".editorconfig found in a subdirectory ($sub) but not at repo root" \
      "add .editorconfig at repo root; without root=true at the top, cross-tool discovery is unreliable"
    return
  fi
  emit_result "$VERDICT_FAIL" ".editorconfig missing" \
    "copy plugins/ai-native-migration/templates/.editorconfig.tmpl to repo root"
}

# ---------- D08 — docs quartet (ARCHITECTURE, DEVELOPMENT, TESTING, PRECOMMIT) ----------
# Rubric §Part 1 D08, v0.2.0 — expanded to four docs. Repository-tour lists
# PRECOMMIT.md as a canonical anchor alongside the other three; earlier rubric
# versions checked only three. See Q-10.
# Pass: all four present. Partial: 2–3 present. Fail: 0–1 present.
check_D08() {
  local dir="$TARGET/docs"
  local -a required=(ARCHITECTURE.md DEVELOPMENT.md TESTING.md PRECOMMIT.md)
  local -a present=()
  local -a missing=()
  local f
  for f in "${required[@]}"; do
    if [[ -s "$dir/$f" ]]; then
      present+=("$f")
    else
      missing+=("$f")
    fi
  done
  local n=${#present[@]}
  case $n in
    4)
      emit_result "$VERDICT_PASS" "docs/ contains all four: ${present[*]}" "" ;;
    0|1)
      local msg="none of the docs quartet present"
      (( n == 1 )) && msg="only 1 of 4 docs present (${present[*]})"
      emit_result "$VERDICT_FAIL" "$msg" \
        "copy plugins/ai-native-migration/templates/docs/{ARCHITECTURE,DEVELOPMENT,TESTING,PRECOMMIT}.md.tmpl into docs/" ;;
    *)
      emit_result "$VERDICT_PARTIAL" "docs quartet incomplete — present: ${present[*]}; missing: ${missing[*]}" \
        "add the missing docs; templates at plugins/ai-native-migration/templates/docs/" ;;
  esac
}

# ---------- D09 — docs/specs/ directory exists ----------
# Rubric §Part 1 D09, v0.2.0. Pass: docs/specs/ is a directory. Fail: not.
# The partial verdict via docs/plans/ was withdrawn in v0.2.0 because the kit
# itself writes plan files into docs/plans/, which would auto-flip D09 from
# fail to partial on the second audit — false positive. See Q-10.
check_D09() {
  if [[ -d "$TARGET/docs/specs" ]]; then
    emit_result "$VERDICT_PASS" "docs/specs/ directory exists" ""
    return
  fi
  emit_result "$VERDICT_FAIL" "docs/specs/ directory missing" \
    "mkdir -p docs/specs/ and add a README explaining the SDD naming convention (NN-slug/NN-spec-slug.md, NN-tasks-slug.md, NN-questions-N-slug.md)"
}

# ---------- shared: cached stack detection ----------
#
# Several checks (D10, D11, D12, D16) need the target's stack. Rather than
# each check invoking detect-stack.sh independently, we call it once lazily
# and cache the result via named vars. Zero cost if no D10+ check runs;
# never more than one invocation if many do.

_STACK_LOADED=0
_STACK=""
_FRAMEWORK=""
_TEST_FRAMEWORK=""
_PACKAGE_MANAGER=""

_load_stack() {
  (( _STACK_LOADED )) && return 0
  _STACK_LOADED=1
  local detect_script="$SCRIPT_DIR/detect-stack.sh"
  if [[ ! -x $detect_script ]]; then
    _STACK=unknown
    return 0
  fi
  local out
  if ! out=$("$detect_script" "$TARGET" 2>/dev/null); then
    _STACK=unknown
    return 0
  fi
  # Extract fields with grep — avoiding a jq dependency. detect-stack.sh's
  # JSON layout is stable (see T-07), and grep -oE with a fixed pattern is
  # good enough for these five scalar fields.
  #
  # `|| true` on each assignment: grep exits 1 when a field is null (no
  # match), which under `set -e` would kill the parent. `pipefail` is set
  # so a pipeline's exit code is that of the last non-zero stage; without
  # the fallback the whole verify run would die silently on the first null
  # field.
  _extract_field() {
    local field=$1 body=$2
    printf '%s' "$body" | grep -oE "\"$field\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" 2>/dev/null \
      | head -n1 \
      | sed 's/.*"\([^"]*\)"$/\1/' \
      || true
  }
  _STACK=$(_extract_field stack "$out")
  _FRAMEWORK=$(_extract_field framework "$out")
  _PACKAGE_MANAGER=$(_extract_field package_manager "$out")
  _TEST_FRAMEWORK=$(_extract_field test_framework "$out")
  [[ -z $_STACK ]] && _STACK=unknown
  # Explicit return 0 — the previous `[[ ]] && ...` short-circuit line
  # returns exit 1 when $_STACK is already set (the [[ -z ]] test is false).
  # Under `set -e` that would kill the caller. `return 0` prevents that.
  return 0
}

# ---------- D10 — Unit test folder(s) exist ----------
# Uses stack-aware detection: search paths and file patterns adjust to the
# detected stack. If stack is unknown, fall back to generic conventions.
check_D10() {
  _load_stack
  local -a hits=()
  case $_STACK in
    java)
      [[ -d "$TARGET/src/test/java" ]] && hits+=("src/test/java/")
      ;;
    node)
      # Prefer tests/ or test/ folders; also accept co-located *.test.* files.
      local d
      for d in tests test __tests__ src/__tests__ src/tests; do
        [[ -d "$TARGET/$d" ]] && hits+=("$d/")
      done
      if [[ ${#hits[@]} -eq 0 ]]; then
        find "$TARGET" -maxdepth 4 \
          \( -name node_modules -o -name .git -o -name dist -o -name build -o -name .next \) -prune \
          -o -type f \( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.test.js' -o -name '*.test.jsx' -o -name '*.spec.ts' -o -name '*.spec.js' \) -print 2>/dev/null \
          | head -n1 | grep -q . && hits+=("co-located *.test.{ts,js}")
      fi
      ;;
    python)
      local d
      for d in tests test; do
        [[ -d "$TARGET/$d" ]] && hits+=("$d/")
      done
      if [[ ${#hits[@]} -eq 0 ]]; then
        find "$TARGET" -maxdepth 4 \
          \( -name .venv -o -name venv -o -name .git -o -name __pycache__ \) -prune \
          -o -type f -name 'test_*.py' -print 2>/dev/null \
          | head -n1 | grep -q . && hits+=("test_*.py files")
      fi
      ;;
    go)
      find "$TARGET" -maxdepth 4 -type f -name '*_test.go' -print 2>/dev/null \
        | head -n1 | grep -q . && hits+=("*_test.go files")
      ;;
    rust)
      [[ -d "$TARGET/tests" ]] && hits+=("tests/")
      grep -rq "#\[cfg(test)\]" "$TARGET/src" 2>/dev/null && hits+=("#[cfg(test)] blocks")
      ;;
    ruby)
      [[ -d "$TARGET/spec" ]] && hits+=("spec/")
      [[ -d "$TARGET/test" ]] && hits+=("test/")
      ;;
    php)
      [[ -d "$TARGET/tests" ]] && hits+=("tests/")
      ;;
    *)
      # Generic fallback: any folder named unit/, tests/unit/, test/unit/.
      local d
      for d in tests test unit tests/unit test/unit; do
        [[ -d "$TARGET/$d" ]] && hits+=("$d/")
      done
      ;;
  esac
  if [[ ${#hits[@]} -gt 0 ]]; then
    emit_result "$VERDICT_PASS" "unit test structure detected: ${hits[*]}" ""
    return
  fi
  # Nothing found. If stack was unknown, this may just be a docs-only repo;
  # but per rubric D10 we still emit fail unless AGENTS.md declares docs-only.
  if [[ -f "$TARGET/AGENTS.md" ]] && grep -qiE '(documentation[[:space:]]+only|docs[[:space:]]+only|no[[:space:]]+build)' "$TARGET/AGENTS.md"; then
    emit_result "$VERDICT_NA" "AGENTS.md declares docs-only project" ""
    return
  fi
  emit_result "$VERDICT_FAIL" "no unit test structure detected (stack=$_STACK)" \
    "add stack-appropriate unit test scaffolding; see docs/TESTING.md for AI-legibility properties"
}

# ---------- D11 — Integration test folder(s) exist ----------
# Distinct from D10 — must be separately identified as integration scope.
check_D11() {
  _load_stack
  local -a hits=()

  # Folder patterns first (fast, high-confidence).
  local d
  for d in \
    src/test/integration src/integration-test tests/integration test/integration \
    integration integration-tests spec/integration spec/features
  do
    [[ -d "$TARGET/$d" ]] && hits+=("$d/")
  done

  # File-naming conventions for stacks where folders aren't used.
  if [[ ${#hits[@]} -eq 0 ]]; then
    case $_STACK in
      node)
        find "$TARGET" -maxdepth 4 \
          \( -name node_modules -o -name .git -o -name dist -o -name build \) -prune \
          -o -type f \( -name '*.integration.test.*' -o -name '*.integration.spec.*' -o -name '*.int.test.*' \) -print 2>/dev/null \
          | head -n1 | grep -q . && hits+=("*.integration.test.* files")
        ;;
      java)
        # Standard Maven/Gradle "-IT.java" pattern
        find "$TARGET/src" -maxdepth 5 -type f -name '*IT.java' -print 2>/dev/null \
          | head -n1 | grep -q . && hits+=("*IT.java files")
        ;;
      python)
        # pytest markers or test_integration_*.py
        find "$TARGET" -maxdepth 4 \
          \( -name .venv -o -name venv -o -name .git -o -name __pycache__ \) -prune \
          -o -type f -name 'test_integration*.py' -print 2>/dev/null \
          | head -n1 | grep -q . && hits+=("test_integration*.py files")
        ;;
    esac
  fi

  if [[ ${#hits[@]} -gt 0 ]]; then
    emit_result "$VERDICT_PASS" "integration test structure detected: ${hits[*]}" ""
    return
  fi
  emit_result "$VERDICT_FAIL" "no integration test structure detected" \
    "create <test-root>/integration/ (or stack-equivalent) and add one representative integration test — the discipline is separating scope"
}

# ---------- D12 — E2E test harness (folder OR config) ----------
check_D12() {
  local -a hits=()
  # Config files are the strongest signal.
  local f
  for f in \
    playwright.config.ts playwright.config.js playwright.config.mjs \
    cypress.config.ts cypress.config.js \
    wdio.conf.ts wdio.conf.js \
    .geb-config.groovy nightwatch.conf.js
  do
    [[ -f "$TARGET/$f" ]] && hits+=("$f")
  done
  # Folders as fallback.
  local d
  for d in e2e-tests e2e tests/e2e test/e2e cypress; do
    [[ -d "$TARGET/$d" ]] && hits+=("$d/")
  done
  if [[ ${#hits[@]} -gt 0 ]]; then
    emit_result "$VERDICT_PASS" "E2E harness detected: ${hits[*]}" ""
    return
  fi
  emit_result "$VERDICT_FAIL" "no E2E test harness detected" \
    "add stack-appropriate E2E scaffolding; Playwright is the default recommendation for web apps (first-class screenshot + trace support)"
}

# ---------- D13 — CI config with build + test + lint gates ----------
# Detects CI system, then greps CI files for the three keyword classes.
check_D13() {
  local -a ci_files=()
  # GitHub Actions
  if [[ -d "$TARGET/.github/workflows" ]]; then
    while IFS= read -r f; do ci_files+=("$f"); done < <(
      find "$TARGET/.github/workflows" -maxdepth 2 -type f \( -name '*.yml' -o -name '*.yaml' \) 2>/dev/null
    )
  fi
  # GitLab CI, CircleCI, Jenkins, Bitbucket, Azure, Buildkite
  local f
  for f in \
    .gitlab-ci.yml .gitlab-ci.yaml \
    .circleci/config.yml .circleci/config.yaml \
    Jenkinsfile \
    bitbucket-pipelines.yml \
    azure-pipelines.yml azure-pipelines.yaml \
    .buildkite/pipeline.yml .buildkite/pipeline.yaml
  do
    [[ -f "$TARGET/$f" ]] && ci_files+=("$f")
  done

  if [[ ${#ci_files[@]} -eq 0 ]]; then
    emit_result "$VERDICT_FAIL" "no CI configuration detected" \
      "add a CI workflow that runs: (a) build/install, (b) test, (c) lint. See plugins/ai-native-migration/templates/.github/workflows/ci.yml.tmpl"
    return
  fi

  # Grep across all CI files for the three keyword classes.
  local has_build=0 has_test=0 has_lint=0
  for f in "${ci_files[@]}"; do
    grep -qiE '(^|[^a-z])(build|compile|install)([^a-z]|$)' "$f" 2>/dev/null && has_build=1
    grep -qiE '(^|[^a-z])(test|spec|check)([^a-z]|$)' "$f" 2>/dev/null && has_test=1
    grep -qiE '(^|[^a-z])(lint|format|prettier|eslint|checkstyle|ruff|clippy|rubocop|golangci)([^a-z]|$)' "$f" 2>/dev/null && has_lint=1
  done
  local found=$((has_build + has_test + has_lint))
  local -a missing=()
  (( has_build == 0 )) && missing+=("build")
  (( has_test == 0 )) && missing+=("test")
  (( has_lint == 0 )) && missing+=("lint")
  case $found in
    3) emit_result "$VERDICT_PASS" "CI (${ci_files[0]##*/}) covers build+test+lint" "" ;;
    0) emit_result "$VERDICT_FAIL" "CI files present but none of build/test/lint keywords detected" \
         "add explicit build, test, and lint steps to CI" ;;
    *) emit_result "$VERDICT_PARTIAL" "CI has ${found}/3 gates; missing: ${missing[*]}" \
         "add the missing gate(s) to CI" ;;
  esac
}

# ---------- D14 — AI review layer configured ----------
check_D14() {
  local -a hits=()
  local f
  for f in \
    .coderabbit.yaml .coderabbit.yml \
    .github/copilot-review-config.yml .github/copilot-review-config.yaml \
    .sweep.yaml
  do
    [[ -f "$TARGET/$f" ]] && hits+=("$f")
  done
  # Grep GH Actions workflow files for known AI reviewer job names / actions.
  if [[ -d "$TARGET/.github/workflows" ]]; then
    while IFS= read -r wf; do
      if grep -qiE '(coderabbit|copilot.review|sweep-ai|codereview.gpt|ai-review)' "$wf" 2>/dev/null; then
        hits+=("$(basename "$wf")")
      fi
    done < <(find "$TARGET/.github/workflows" -maxdepth 2 -type f \( -name '*.yml' -o -name '*.yaml' \) 2>/dev/null)
  fi
  if [[ ${#hits[@]} -gt 0 ]]; then
    emit_result "$VERDICT_PASS" "AI review layer detected: ${hits[*]}" ""
    return
  fi
  emit_result "$VERDICT_FAIL" "no AI review layer detected" \
    "copy plugins/ai-native-migration/templates/.coderabbit.yaml.tmpl or wire an equivalent reviewer; AI review is the policy-independent second opinion on every PR"
}

# ---------- D15 — Conventional Commits enabled ----------
check_D15() {
  local -a hits=()
  # 1. .gitmessage template
  [[ -f "$TARGET/.gitmessage" ]] && hits+=(".gitmessage")
  # 2. commitlint config
  local f
  for f in commitlint.config.js commitlint.config.ts commitlint.config.mjs commitlint.config.cjs .commitlintrc .commitlintrc.json; do
    [[ -f "$TARGET/$f" ]] && hits+=("$f")
  done
  # 3. Pre-commit hook enforcing conventional-commits
  if [[ -f "$TARGET/.pre-commit-config.yaml" ]] || [[ -f "$TARGET/.pre-commit-config.yml" ]]; then
    local pcc="$TARGET/.pre-commit-config.yaml"
    [[ ! -f $pcc ]] && pcc="$TARGET/.pre-commit-config.yml"
    if grep -qE '(conventional-pre-commit|commitizen|conventional-commits)' "$pcc" 2>/dev/null; then
      hits+=("pre-commit hook (conventional-commits)")
    fi
  fi
  # 4. Slash command or skill named commit
  [[ -f "$TARGET/.claude/commands/commit.md" ]] && hits+=(".claude/commands/commit.md")
  [[ -d "$TARGET/.claude/skills/conventional-commits" ]] && hits+=(".claude/skills/conventional-commits/")
  # 5. commitizen config in package.json
  if [[ -f "$TARGET/package.json" ]] && grep -qE '"commitizen"[[:space:]]*:' "$TARGET/package.json" 2>/dev/null; then
    hits+=("package.json commitizen config")
  fi

  if [[ ${#hits[@]} -eq 0 ]]; then
    emit_result "$VERDICT_FAIL" "no Conventional Commits mechanism detected" \
      "add .gitmessage template + commit-msg pre-commit hook (conventional-pre-commit or commitizen)"
    return
  fi
  # Partial: only .gitmessage without enforcement (template but no hook).
  if [[ ${#hits[@]} -eq 1 ]] && [[ ${hits[0]} == ".gitmessage" ]]; then
    emit_result "$VERDICT_PARTIAL" ".gitmessage present but no enforcement (hook/lint/skill)" \
      "add commit-msg pre-commit hook so the convention is enforced, not just suggested"
    return
  fi
  emit_result "$VERDICT_PASS" "Conventional Commits enabled: ${hits[*]}" ""
}

# ---------- D16 — Stack-specific linter/style config present ----------
check_D16() {
  _load_stack
  if [[ $_STACK == unknown ]]; then
    emit_result "$VERDICT_NA" "stack undetected; linter check requires a known stack" ""
    return
  fi
  local -a hits=()
  local f
  case $_STACK in
    java)
      for f in checkstyle.xml .checkstyle spotbugs-exclude.xml pmd.xml; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      ;;
    node)
      for f in eslint.config.js eslint.config.mjs eslint.config.ts eslint.config.cjs \
              .eslintrc .eslintrc.json .eslintrc.js .eslintrc.yml .eslintrc.yaml \
              biome.json biome.jsonc \
              .prettierrc .prettierrc.json .prettierrc.js .prettierrc.yml prettier.config.js; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      ;;
    python)
      for f in .ruff.toml ruff.toml .pylintrc .flake8 mypy.ini .mypy.ini pyrightconfig.json; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      # pyproject.toml with [tool.ruff|black|mypy]
      if [[ -f "$TARGET/pyproject.toml" ]] && grep -qE '\[tool\.(ruff|black|mypy)' "$TARGET/pyproject.toml"; then
        hits+=("pyproject.toml [tool.ruff|black|mypy]")
      fi
      ;;
    go)
      for f in .golangci.yml .golangci.yaml .golangci.toml; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      ;;
    rust)
      for f in .rustfmt.toml rustfmt.toml clippy.toml .clippy.toml; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      ;;
    ruby)
      for f in .rubocop.yml .rubocop.yaml .standard.yml; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      ;;
    php)
      for f in phpcs.xml phpcs.xml.dist .php-cs-fixer.php .php-cs-fixer.dist.php phpstan.neon psalm.xml; do
        [[ -f "$TARGET/$f" ]] && hits+=("$f")
      done
      ;;
  esac
  if [[ ${#hits[@]} -gt 0 ]]; then
    emit_result "$VERDICT_PASS" "stack-specific linter config: ${hits[*]}" ""
    return
  fi
  emit_result "$VERDICT_FAIL" "no linter/style config detected for stack=$_STACK" \
    "add the standard linter for the detected stack; override defaults in the config file if the team dislikes them, but do not skip the config"
}

# ---------- D17 — .claude/commands/ or .claude/skills/ non-empty ----------
check_D17() {
  local cmds="$TARGET/.claude/commands"
  local skls="$TARGET/.claude/skills"
  local cmds_exists=0 skls_exists=0
  local cmds_nonempty=0 skls_nonempty=0
  [[ -d $cmds ]] && cmds_exists=1
  [[ -d $skls ]] && skls_exists=1
  if (( cmds_exists )); then
    # Count entries, excluding hidden/dot files.
    if [[ -n $(find "$cmds" -mindepth 1 -maxdepth 1 -not -name '.*' -print -quit 2>/dev/null) ]]; then
      cmds_nonempty=1
    fi
  fi
  if (( skls_exists )); then
    if [[ -n $(find "$skls" -mindepth 1 -maxdepth 1 -not -name '.*' -print -quit 2>/dev/null) ]]; then
      skls_nonempty=1
    fi
  fi
  if (( cmds_nonempty || skls_nonempty )); then
    local -a found=()
    (( cmds_nonempty )) && found+=(".claude/commands/")
    (( skls_nonempty )) && found+=(".claude/skills/")
    emit_result "$VERDICT_PASS" "reusable agent workflows present in: ${found[*]}" ""
    return
  fi
  if (( cmds_exists || skls_exists )); then
    emit_result "$VERDICT_PARTIAL" ".claude/commands or .claude/skills exists but is empty" \
      "add at least one project-scoped slash command or skill (e.g., /commit, /review, an SDD flow)"
    return
  fi
  emit_result "$VERDICT_FAIL" "no .claude/commands/ or .claude/skills/ directory" \
    "mkdir -p .claude/commands && add at least one slash command backing a repeatable workflow"
}

# ---------- D18 — Onboarding automation activates guardrails ----------
# Depends on D06: if D06 fails, D18 is n/a and the plan surfaces D06 as
# higher priority. Otherwise, look for a script/target that includes an
# activation command.
check_D18() {
  local pcc_present=0
  [[ -f "$TARGET/.pre-commit-config.yaml" ]] || [[ -f "$TARGET/.pre-commit-config.yml" ]] && pcc_present=1
  if (( ! pcc_present )); then
    emit_result "$VERDICT_NA" "no .pre-commit-config to activate (D06 fails first)" ""
    return
  fi

  local -a mechanisms=()
  # 1. Executable script under scripts/
  local s
  for s in scripts/setup-precommit.sh scripts/setup.sh scripts/bootstrap.sh scripts/install-hooks.sh scripts/dev-setup.sh; do
    if [[ -f "$TARGET/$s" ]] && grep -qE 'pre-commit[[:space:]]+install' "$TARGET/$s" 2>/dev/null; then
      mechanisms+=("$s")
    fi
  done
  # 2. Makefile target running pre-commit install
  if [[ -f "$TARGET/Makefile" ]] && grep -qE 'pre-commit[[:space:]]+install' "$TARGET/Makefile" 2>/dev/null; then
    mechanisms+=("Makefile")
  fi
  # 3. package.json postinstall or scripts entry
  if [[ -f "$TARGET/package.json" ]] && grep -qE '"(postinstall|prepare|setup|bootstrap)"[[:space:]]*:.*pre-commit' "$TARGET/package.json" 2>/dev/null; then
    mechanisms+=("package.json script")
  fi
  # 4. devcontainer postCreateCommand
  if [[ -f "$TARGET/.devcontainer/devcontainer.json" ]] && grep -qE '"postCreateCommand".*pre-commit' "$TARGET/.devcontainer/devcontainer.json" 2>/dev/null; then
    mechanisms+=(".devcontainer postCreateCommand")
  fi

  if [[ ${#mechanisms[@]} -gt 0 ]]; then
    emit_result "$VERDICT_PASS" "onboarding activation via: ${mechanisms[*]}" ""
    return
  fi

  # No activation mechanism. If a scripts/setup-*.sh exists but doesn't include
  # pre-commit install, flag as partial.
  local script_without_activation=""
  for s in scripts/setup-precommit.sh scripts/setup.sh scripts/bootstrap.sh; do
    if [[ -f "$TARGET/$s" ]]; then
      script_without_activation=$s
      break
    fi
  done
  if [[ -n $script_without_activation ]]; then
    emit_result "$VERDICT_PARTIAL" "$script_without_activation exists but does not run 'pre-commit install'" \
      "add 'pre-commit install' (and --hook-type commit-msg) to the setup script"
    return
  fi
  emit_result "$VERDICT_FAIL" ".pre-commit-config present but no activation script — hooks are inert" \
    "copy plugins/ai-native-migration/templates/scripts/setup-precommit.sh.tmpl to scripts/ and reference it from AGENTS.md Key Commands"
}

# ---------- run all requested checks ----------

# Accumulate results into parallel arrays. Indexed by ID position within
# CHECKS_TO_RUN. Simpler than an associative array and preserves order.
RESULT_ID=()
RESULT_VERDICT=()
RESULT_EVIDENCE=()
RESULT_REMEDIATION=()

count_pass=0
count_partial=0
count_fail=0
count_na=0
# Severity-tier counts introduced in rubric v0.2.0. See Q-10.
count_mandatory_fails=0
count_nice_to_have_fails=0

# ---------- run_check dispatcher (added v0.2.0 per spec 02 §5) ----------
#
# Wraps `check_<id>` so per-check scope can be honored uniformly. In P-4
# (this phase), all scopes dispatch to the direct check function — the
# router is wired but semantically transparent. Per-workspace iteration
# and root-primary fallback wire up in P-5 alongside the check-function
# refactor that lets each check accept an optional workspace argument.
#
# Contract: same stdout shape as `check_<id>` — a single line of
# "<verdict>|<evidence>|<remediation>" so the main loop below reads
# it unchanged.
run_check() {
  local id=$1
  local scope=${CHECK_SCOPE[$id]:-$SCOPE_ROOT_ONLY}
  case $scope in
    "$SCOPE_ROOT_ONLY")
      "check_$id"
      ;;
    "$SCOPE_PER_WORKSPACE"|"$SCOPE_ROOT_PRIMARY")
      # P-5 replaces this with workspace iteration + aggregation.
      "check_$id"
      ;;
    *)
      die "unknown scope for $id: $scope"
      ;;
  esac
}

for id in "${CHECKS_TO_RUN[@]}"; do
  # Run the check. Capture its single-line output.
  raw=$(run_check "$id")
  # Split on | (unescape \p back to | in fields).
  IFS='|' read -r verdict evidence remediation <<<"$raw"
  evidence=${evidence//\\p/|}
  remediation=${remediation//\\p/|}

  RESULT_ID+=("$id")
  RESULT_VERDICT+=("$verdict")
  RESULT_EVIDENCE+=("$evidence")
  RESULT_REMEDIATION+=("$remediation")

  # NOTE: use pre-increment (++var) not post-increment (var++). With `set -e`,
  # post-increment returns exit 1 when the pre-value is 0, silently killing
  # the script on the first n/a. Pre-increment returns the post-value, so the
  # first increment returns 1 (truthy). See bash arithmetic-command semantics.
  case $verdict in
    "$VERDICT_PASS")    (( ++count_pass )) ;;
    "$VERDICT_PARTIAL") (( ++count_partial )) ;;
    "$VERDICT_FAIL")    (( ++count_fail )) ;;
    "$VERDICT_NA")      (( ++count_na )) ;;
    *) die "check_$id returned unknown verdict: $verdict" ;;
  esac

  # Severity-scoped fail counters — used for the differentiated exit code.
  if [[ $verdict == "$VERDICT_FAIL" ]]; then
    case ${CHECK_SEVERITY[$id]:-$SEVERITY_MANDATORY} in
      "$SEVERITY_MANDATORY")    (( ++count_mandatory_fails )) ;;
      "$SEVERITY_NICE_TO_HAVE") (( ++count_nice_to_have_fails )) ;;
    esac
  fi
done

# ---------- output formatting ----------

emit_text() {
  # Color codes; suppressed by --no-color or when stdout isn't a TTY.
  local green="" yellow="" red="" gray="" bold="" reset=""
  if (( NO_COLOR == 0 )) && [[ -t 1 ]]; then
    green=$'\033[32m'
    yellow=$'\033[33m'
    red=$'\033[31m'
    gray=$'\033[90m'
    bold=$'\033[1m'
    reset=$'\033[0m'
  fi

  printf '%sai-native-verify%s — %s\n' "$bold" "$reset" "$TARGET"
  printf '%srubric %s%s\n\n' "$gray" "$ANMK_RUBRIC_VERSION" "$reset"

  local i
  for (( i=0; i<${#RESULT_ID[@]}; i++ )); do
    local id=${RESULT_ID[$i]}
    local verdict=${RESULT_VERDICT[$i]}
    local evidence=${RESULT_EVIDENCE[$i]}
    local label=${CHECK_LABEL[$id]}
    local color
    case $verdict in
      "$VERDICT_PASS")    color=$green ;;
      "$VERDICT_PARTIAL") color=$yellow ;;
      "$VERDICT_FAIL")    color=$red ;;
      *)                  color=$gray ;;
    esac
    # Show severity as a subtle suffix so mandatory vs. nice-to-have vs.
    # conditional distinctions are visible without cluttering the main line.
    local sev=${CHECK_SEVERITY[$id]:-$SEVERITY_MANDATORY}
    local sev_marker=""
    case $sev in
      "$SEVERITY_NICE_TO_HAVE") sev_marker=" ${gray}[nice-to-have]${reset}" ;;
      "$SEVERITY_CONDITIONAL")  sev_marker=" ${gray}[conditional]${reset}" ;;
    esac
    printf '  %s%-8s%s  %s — %s%s\n' "$color" "$verdict" "$reset" "$id" "$label" "$sev_marker"
    [[ -n $evidence ]] && printf '            %s\n' "$evidence"
  done

  printf '\n%ssummary%s  %d pass · %d partial · %d fail · %d n/a' \
    "$bold" "$reset" "$count_pass" "$count_partial" "$count_fail" "$count_na"
  if (( count_mandatory_fails > 0 || count_nice_to_have_fails > 0 )); then
    printf '\n%s  fails%s  %d mandatory · %d nice-to-have' \
      "$bold" "$reset" "$count_mandatory_fails" "$count_nice_to_have_fails"
  fi
  printf '\n'
}

emit_json() {
  # JSON envelope conforming to the schema documented in docs/DEVELOPMENT.md.
  # Results array preserves the order checks were run in (rubric order when
  # --check is omitted, otherwise the order in ALL_CHECKS filtered by the
  # request). Consumers should not depend on order for correctness — they
  # can look up results by `id`.

  # Ensure stack info is loaded so downstream callers (the agentic workflow)
  # don't need to invoke detect-stack.sh separately. Cheap if already loaded.
  _load_stack

  # Determine what the final exit code WILL be, so the JSON output carries
  # the same signal a script would get from $?.
  # Severity-differentiated exit code (rubric v0.2.0 — see Q-10):
  #   2 = at least one MANDATORY fail (blocking)
  #   1 = at least one nice-to-have fail OR any partial (advisory)
  #   0 = clean or n/a only
  local exit_code=0
  if (( count_mandatory_fails > 0 )); then exit_code=2
  elif (( count_nice_to_have_fails > 0 || count_partial > 0 )); then exit_code=1
  fi

  # Build stack object.
  local stack_json
  local framework_val="${_FRAMEWORK:-}"
  local pm_val="${_PACKAGE_MANAGER:-}"
  local tf_val="${_TEST_FRAMEWORK:-}"
  # Quote-or-null helper inline.
  local fw_field pm_field tf_field
  [[ -n $framework_val ]] && fw_field="\"$(json_escape "$framework_val")\"" || fw_field=null
  [[ -n $pm_val ]] && pm_field="\"$(json_escape "$pm_val")\"" || pm_field=null
  [[ -n $tf_val ]] && tf_field="\"$(json_escape "$tf_val")\"" || tf_field=null
  stack_json=$(printf '{"stack": "%s", "framework": %s, "package_manager": %s, "test_framework": %s}' \
    "$(json_escape "${_STACK:-unknown}")" "$fw_field" "$pm_field" "$tf_field")

  # Determine checks_requested — either "all" or the explicit user list.
  local checks_requested_json
  if [[ -z $CHECKS ]]; then
    checks_requested_json='"all"'
  else
    local ids_json="" id first=1
    for id in "${CHECKS_TO_RUN[@]}"; do
      if (( first == 0 )); then ids_json+=", "; fi
      first=0
      ids_json+="\"$id\""
    done
    checks_requested_json="[$ids_json]"
  fi

  printf '{\n'
  printf '  "schema_version": "1",\n'
  printf '  "target": "%s",\n' "$(json_escape "$TARGET")"
  printf '  "rubric_version": "%s",\n' "$ANMK_RUBRIC_VERSION"
  printf '  "checks_requested": %s,\n' "$checks_requested_json"
  printf '  "stack": %s,\n' "$stack_json"
  printf '  "results": [\n'
  local i first=1
  for (( i=0; i<${#RESULT_ID[@]}; i++ )); do
    if (( first == 0 )); then printf ',\n'; fi
    first=0
    printf '    {"id": "%s", "label": "%s", "verdict": "%s", "severity": "%s", "evidence": "%s", "remediation_hint": "%s"}' \
      "${RESULT_ID[$i]}" \
      "$(json_escape "${CHECK_LABEL[${RESULT_ID[$i]}]}")" \
      "${RESULT_VERDICT[$i]}" \
      "${CHECK_SEVERITY[${RESULT_ID[$i]}]:-$SEVERITY_MANDATORY}" \
      "$(json_escape "${RESULT_EVIDENCE[$i]}")" \
      "$(json_escape "${RESULT_REMEDIATION[$i]}")"
  done
  printf '\n  ],\n'
  printf '  "summary": {"pass": %d, "partial": %d, "fail": %d, "na": %d, "mandatory_fails": %d, "nice_to_have_fails": %d},\n' \
    "$count_pass" "$count_partial" "$count_fail" "$count_na" \
    "$count_mandatory_fails" "$count_nice_to_have_fails"
  printf '  "exit_code": %d\n' "$exit_code"
  printf '}\n'
}

case $FORMAT in
  text) emit_text ;;
  json) emit_json ;;
esac

# ---------- exit code ----------

# Severity-differentiated exit code (rubric v0.2.0 — see Q-10).
if (( count_mandatory_fails > 0 )); then
  exit 2
elif (( count_nice_to_have_fails > 0 || count_partial > 0 )); then
  exit 1
else
  exit 0
fi
