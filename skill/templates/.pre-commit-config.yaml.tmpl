# pre-commit — https://pre-commit.com
#
# Local pre-commit hooks that run on `git commit` and `git push`.
# The rubric expects both this file (D06) AND an onboarding script that
# actually activates the hooks on `git clone` (D18) — a committed config
# without activation is inert.
#
# Baseline hooks below are stack-neutral. Add stack-specific hooks in the
# marked block. Do not delete the commit-msg hook — Conventional Commits
# enforcement (D15) depends on it.

repos:
  # ────────────────────────────────────────────────────────────────────
  # UNIVERSAL — file hygiene and common footguns
  # ────────────────────────────────────────────────────────────────────
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-merge-conflict
      - id: check-added-large-files
        args: [--maxkb=500]     # bump if you legitimately commit large assets
      - id: check-yaml
      - id: check-json
      - id: check-toml
      - id: detect-private-key
      - id: mixed-line-ending
        args: [--fix=lf]

  # ────────────────────────────────────────────────────────────────────
  # COMMIT MESSAGE — Conventional Commits (D15)
  # ────────────────────────────────────────────────────────────────────
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v3.6.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
        args: [--strict]

  # ────────────────────────────────────────────────────────────────────
  # SECURITY — secret scanning
  # ────────────────────────────────────────────────────────────────────
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.21.2
    hooks:
      - id: gitleaks

  # ────────────────────────────────────────────────────────────────────
  # SHELL — lint the onboarding scripts and any project shell
  # ────────────────────────────────────────────────────────────────────
  - repo: https://github.com/shellcheck-py/shellcheck-py
    rev: v0.10.0.1
    hooks:
      - id: shellcheck

  # ────────────────────────────────────────────────────────────────────
  # MARKDOWN — lint the docs
  # ────────────────────────────────────────────────────────────────────
  - repo: https://github.com/igorshubovych/markdownlint-cli
    rev: v0.42.0
    hooks:
      - id: markdownlint
        args: [--config=.markdownlint.yaml, --ignore=CHANGELOG.md]

  # ────────────────────────────────────────────────────────────────────
  # STACK-SPECIFIC HOOKS
  # Uncomment or add the block that matches your target stack. Common
  # examples below — pin the `rev` to a specific tag per hook repo.
  # ────────────────────────────────────────────────────────────────────
