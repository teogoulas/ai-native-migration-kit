# OS
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Node / pnpm (may appear if we ever add lint tooling)
node_modules/
npm-debug.log*
pnpm-debug.log*
.pnpm-store/

# Python (pre-commit uses pip locally)
__pycache__/
*.pyc
.venv/
venv/

# Claude Code — session-scoped, do not commit
.claude/audit.log
.claude/sessions/
.claude/tool-results/

# Test scratch dirs
tests/fixtures/*/scratch/

# Generated audit / plan output (belongs in target repos, never here).
# Match contents (docs/plans/*), not the directory itself, so the negation
# below can re-include curated files. dogfood-decisions.md is the kit's own
# accepted-findings record — curated documentation, not audit output.
docs/plans/*
!docs/plans/dogfood-decisions.md

# Artifacts parked locally when PAT scope blocks pushing to protected paths
# (e.g., .github/workflows/**). See questions file Q-08. The user pushes
# these manually via web UI or after expanding PAT scope.
*.pending
